{:paths ["src-common" "resources"]
 :deps  {org.clojure/clojure      {:mvn/version "1.12.6"}
         org.clojure/core.async   {:mvn/version "1.9.865"}
         org.clojure/core.memoize {:mvn/version "1.2.281"}

         ;; data
         org.clojure/data.json       {:mvn/version "2.5.2"}
         org.clojure/data.xml        {:mvn/version "0.0.8"}
         org.apache.santuario/xmlsec {:mvn/version "4.0.4"}
         cheshire/cheshire           {:mvn/version "6.2.0"}
         commons-io/commons-io       {:mvn/version "2.22.0"}
         commons-codec/commons-codec {:mvn/version "1.23.0"}
         com.velisco/strgen          {:mvn/version "0.2.5" :exclusions [org.clojure/clojurescript]}

         ;; http
         ring/ring-core                 {:mvn/version "1.15.6"}
         ring/ring-jetty-adapter        {:mvn/version "1.15.6"}
         ring/ring-defaults             {:mvn/version "0.7.1"}
         compojure/compojure            {:mvn/version "1.7.2"}
         nl.jomco/ring-trace-context    {:mvn/version "0.0.8"}
         nl.jomco/clj-http-status-codes {:mvn/version "0.2"}
         nl.jomco/openapi-v3-validator  {:mvn/version "0.2.10"}

         org.eclipse.jetty/jetty-unixdomain-server {:mvn/version "12.1.14"}
         org.eclipse.jetty.ee9.websocket/jetty-ee9-websocket-jetty-server {:mvn/version "12.1.14"}

         ;; interface
         nl.jomco/envopts     {:mvn/version "0.0.7"}
         clj-time/clj-time        {:mvn/version "0.15.2"}
         clj-http/clj-http    {:mvn/version "3.13.1"}
         com.taoensso/carmine {:mvn/version "3.5.0" :exclusions [org.clojure/tools.reader com.taoensso/nippy io.airlift/aircompressor]}
         com.taoensso/nippy   {:mvn/version "3.9.0"}
         io.airlift/aircompressor {:mvn/version "2.0.3"}


         ;; logging
         org.clojure/tools.logging                   {:mvn/version "1.3.1"}
         ch.qos.logback.contrib/logback-jackson      {:mvn/version "0.1.5"}
         ch.qos.logback.contrib/logback-json-classic {:mvn/version "0.1.5"}
         ch.qos.logback/logback-classic              {:mvn/version "1.6.5"}
         com.fasterxml.jackson.core/jackson-core     {:mvn/version "2.22.4"}
         com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.22.4"}
         com.github.steffan-westcott/clj-otel-api    {:mvn/version "0.2.10"}}

 :aliases
 {:dev {:extra-paths ["dev" "src-v5" "test-v5" "test-v6" "src-v6"] ;; include all paths when running in the REPL
        :extra-deps  {clj-commons/clj-yaml {:mvn/version "RELEASE"}
                      expound/expound      {:mvn/version "RELEASE"}}}

  :test-common {:extra-paths ["test-common"]
                :jvm-opts    ["-Dclojure.main.report=stderr"]
                :extra-deps  {lambdaisland/kaocha {:mvn/version "RELEASE"}
                              ring/ring-mock      {:mvn/version "RELEASE"}}
                :main-opts   ["-m" "kaocha.runner"]}

  :v5 {:extra-paths ["src-v5"]}

  :test-v5 {:extra-paths ["test-common" "src-v5" "test-v5"]
            :jvm-opts    ["-Dclojure.main.report=stderr"]
            :extra-deps  {lambdaisland/kaocha {:mvn/version "RELEASE"}
                          ring/ring-mock      {:mvn/version "RELEASE"}}
            :main-opts   ["-m" "kaocha.runner"]}


  :v6 {:extra-paths ["src-v6"]}

  :test-v6 {:extra-paths ["test-common" "src-v6" "test-v6"]
            :jvm-opts    ["-Dclojure.main.report=stderr"]
            :extra-deps  {lambdaisland/kaocha {:mvn/version "RELEASE"}
                          ring/ring-mock      {:mvn/version "RELEASE"}}
            :main-opts   ["-m" "kaocha.runner"]}

  :proof-specs {:extra-deps {nl.jomco/proof-specs {:mvn/version "RELEASE"}}
                :main-opts  ["-m" "nl.jomco.proof-specs"
                             "--verbose"
                             "--num-vals" "10"
                             "--limit-ms" "5000"
                             "--include" "nl.surf.*"
                             "--require" "nl.surf.eduhub-rio-mapper.specs.ooapi"]}

  :lint {:paths        []
         :replace-deps {clj-kondo/clj-kondo {:mvn/version "RELEASE"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src-v5" "src-v6" "src-common" "test-v5" "test-v6" "test-common"]}

  :package-v5 {:extra-paths ["target/classes-v5"]}
  :package-v6 {:extra-paths ["target/classes-v6"]}
  :uberjar {:replace-deps {uberdeps/uberdeps   {:mvn/version "RELEASE"}
                           org.clojure/clojure {:mvn/version "RELEASE"}}
            :main-opts    ["-m" "uberdeps.uberjar"]}

  :watson {:paths        []
           :jvm-opts     ["--enable-native-access=ALL-UNNAMED"]
           :replace-deps {io.github.clj-holmes/clj-watson {:git/tag "v6.2.0"
                                                           :git/sha "c0dcdf323efb349baa9ec964298f725baccda73b"}
                          org.owasp/dependency-check-core {:mvn/version "RELEASE"}}
           :main-opts    ["-m" "clj-watson.cli" "scan" "-w" ".watson.properties" "-p" "deps.edn" "-f" "-s" "-a" "deps-to-scan"]}

  :antq {:paths        []
         :replace-deps {com.github.liquidz/antq {:mvn/version "RELEASE"}
                        org.slf4j/slf4j-nop    ^:antq/exclude {:mvn/version "1.7.36"}}
         :main-opts    ["-m" "antq.core" "--skip=github-action"]}

  :mapper {:extra-paths ["src-v5"]
           :main-opts   ["-m" "nl.surf.eduhub-rio-mapper.v5.main"]}

  :mapper-v6 {:replace-paths ["src-v6" "src-common" "resources" "test-v6" "test-common"]
              :main-opts     ["-m" "nl.surf.eduhub-rio-mapper.v6.main"]}

  :deps-to-scan {:extra-deps {io.opentelemetry.javaagent/opentelemetry-javaagent ^:antq/exclude {:mvn/version "2.9.0"}}}}}
